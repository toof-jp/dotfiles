{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-fable-5[1m]",
  "skipDangerousModePermissionPrompt": true,
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(cd)",
      "Bash(cd *)",
      "Bash(curl *)",
      "Bash(jq *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(op read *)",
      "Bash(rm *)",
      "Bash(opencode *)",
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl top *)",
      "Bash(kubectl explain *)",
      "Bash(kubectl diff *)",
      "Bash(kubectl version)",
      "Bash(kubectl cluster-info)",
      "Bash(kubectl api-resources)",
      "Bash(kubectl api-versions)",
      "Bash(kubectl config view)",
      "Bash(kubectl config get-contexts)",
      "Bash(kubectl config current-context)",
      "Bash(gh pr view *)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr status*)",
      "Bash(gh pr checkout *)",
      "Bash(gh pr create *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list*)",
      "Bash(gh issue create *)",
      "Bash(gh run view *)",
      "Bash(gh run list*)",
      "Bash(gh run watch *)",
      "Bash(gh workflow view *)",
      "Bash(gh workflow list*)",
      "Bash(gh repo view *)",
      "Bash(gh repo list*)",
      "Bash(gh release view *)",
      "Bash(gh release list*)",
      "Bash(gh search *)",
      "Bash(gh status)",
      "Bash(gh auth status)",
      "Bash(gh browse *)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  },
  "cleanupPeriodDays": 99999999
}
